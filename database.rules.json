{
  "rules": {
    ".read": false,
    ".write": false,
    "companies": {
      "$companyId": {
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "typing": {
          "$chatId": {
            ".read": "auth != null",
            "$uid": {
              ".read": "auth != null",
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        },
        "recording": {
          "$chatId": {
            ".read": "auth != null",
            "$uid": {
              ".read": "auth != null",
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        }
      }
    }
  }
}
